# Copie para .env (uso local) ou cadastre cada variável em Vercel > Settings > Environment Variables.
# NUNCA envie o arquivo .env real para o GitHub.

# Administrador principal: criado automaticamente no 1º acesso (só se ainda não existir nenhuma conta).
# Depois disso, a senha é trocada pelo próprio painel (Minha conta) e ADMIN_PASSWORD deixa de ser usada.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Chave aleatória para assinar o login do painel (gere: openssl rand -hex 32)
SESSION_SECRET=

# Sal do hash de IP (gere: openssl rand -hex 16). Se vazio, usa o SESSION_SECRET.
IP_SALT=

# Conexão com o Postgres (Neon / Supabase / Vercel Postgres). Prefira a URL "pooled".
DATABASE_URL=
